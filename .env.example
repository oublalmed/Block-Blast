# ================================
# BLOCK BLAST - MONETIZATION CONFIG
# ================================

# This is an example environment file.
# Copy this to .env and fill in your actual values.

# ================================
# STRIPE PAYMENT INTEGRATION
# ================================
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production

# Stripe Publishable Key (starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Stripe Price IDs (create these in Stripe Dashboard > Products)
VITE_STRIPE_PREMIUM_PRICE_ID=price_YOUR_PREMIUM_PRICE_ID
VITE_STRIPE_COINS_500_PRICE_ID=price_YOUR_COINS_500_ID
VITE_STRIPE_COINS_1200_PRICE_ID=price_YOUR_COINS_1200_ID
VITE_STRIPE_COINS_3000_PRICE_ID=price_YOUR_COINS_3000_ID
VITE_STRIPE_COINS_10000_PRICE_ID=price_YOUR_COINS_10000_ID

# ================================
# GOOGLE ADSENSE INTEGRATION
# ================================
# Get your AdSense account from: https://www.google.com/adsense

# AdSense Client ID (starts with ca-pub-)
VITE_ADSENSE_CLIENT_ID=ca-pub-YOUR_PUBLISHER_ID

# Ad Unit Slot IDs (create these in AdSense Dashboard)
VITE_ADSENSE_SLOT_BOTTOM=1234567890
VITE_ADSENSE_SLOT_TOP=0987654321

# Enable/Disable Ads (true/false)
VITE_ADSENSE_ENABLED=true

# ================================
# GOOGLE ANALYTICS 4
# ================================
# Get from: https://analytics.google.com

# GA4 Measurement ID (starts with G-)
VITE_GA4_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID

# Enable Revenue Tracking
VITE_REVENUE_TRACKING_ENABLED=true

# ================================
# DEVELOPMENT NOTES
# ================================
# - Use test keys during development
# - Never commit your .env file to git (it's in .gitignore)
# - For production, set these in your hosting platform's environment variables
# - Test payments with Stripe test cards: https://stripe.com/docs/testing
