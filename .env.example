# ================================
# BLOCK BLAST - GOOGLE PLAY CONFIG
# ================================
# 
# This game is monetized ONLY through:
# - Google AdMob (advertisements)
#
# No in-app purchases are used.

# ================================
# GOOGLE ADMOB CONFIGURATION
# ================================
# Get your AdMob account from: https://apps.admob.com
#
# Steps:
# 1. Create an AdMob account
# 2. Add your Android app
# 3. Create ad units for each type
# 4. Replace the IDs below with your actual ad unit IDs

# Enable/Disable Ads (true/false)
VITE_ADMOB_ENABLED=true

# AdMob App ID (also add to AndroidManifest.xml)
# Format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
VITE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# Ad Unit IDs
# Banner Ad (shown during gameplay)
VITE_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111

# Interstitial Ad (shown between levels)
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712

# Rewarded Ad (watch for coins)
VITE_ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917

# Optional: Comma-separated test device IDs
# VITE_ADMOB_TEST_DEVICE_IDS=ABCDEF0123456789,0123456789ABCDEF

# ================================
# TEST AD UNIT IDS (for development)
# ================================
# The IDs above are Google's official test IDs.
# Use these during development to avoid policy violations.
#
# For production, replace with your actual ad unit IDs.
#
# Test IDs Reference:
# - App ID: ca-app-pub-3940256099942544~3347511713
# - Banner: ca-app-pub-3940256099942544/6300978111
# - Interstitial: ca-app-pub-3940256099942544/1033173712
# - Rewarded: ca-app-pub-3940256099942544/5224354917

# ================================
# GOOGLE ANALYTICS 4 (Optional)
# ================================
# For tracking revenue and user behavior
# Get from: https://analytics.google.com

# GA4 Measurement ID (starts with G-)
VITE_GA4_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID

# Enable Analytics
VITE_ANALYTICS_ENABLED=false

# ================================
# IMPORTANT NOTES
# ================================
# - NEVER commit .env file to git (it's in .gitignore)
# - Use test ad IDs during development
# - Replace with production IDs before Google Play submission
# - Use real ad unit IDs before Google Play submission
