# ================================
# BLOCK BLAST - GOOGLE PLAY SETUP
# ================================
#
# This project no longer uses external payment providers.
# Google Play requires in-app purchases to use Play Billing.
# Ads must use Google AdMob.
#
# Configure product IDs and AdMob unit IDs in:
#   /src/config/monetization.ts
#
# Android AdMob App ID is configured in native files:
#   - android/app/src/main/AndroidManifest.xml
#   - or app.json (if using React Native config plugins)
#
# No .env values are required for Play Billing.
