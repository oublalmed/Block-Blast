# ================================
# BLOCK BLAST - GOOGLE PLAY MONETIZATION CONFIG
# ================================
#
# This app uses ONLY Google Play Billing and Google AdMob for monetization.
# External payment processors (Stripe, PayPal, etc.) are NOT allowed on Google Play.
#
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# ================================
# GOOGLE ADMOB CONFIGURATION
# ================================
# Get your AdMob IDs from: https://admob.google.com
#
# IMPORTANT: The default values below are Google's TEST IDs.
# Replace them with your actual AdMob IDs before publishing!
# Test IDs are safe during development but won't generate revenue.

# AdMob App ID (required for SDK initialization)
# Find in: AdMob Console > Apps > Your App > App settings
VITE_ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713

# Banner Ad Unit ID
# Shows a small banner at the bottom/top of the screen
VITE_ADMOB_BANNER_ANDROID=ca-app-pub-3940256099942544/6300978111

# Interstitial Ad Unit ID
# Full-screen ad shown between game sessions
VITE_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-3940256099942544/1033173712

# Rewarded Ad Unit ID
# Video ad that rewards users with coins
VITE_ADMOB_REWARDED_ANDROID=ca-app-pub-3940256099942544/5224354917

# ================================
# GOOGLE ANALYTICS (Optional)
# ================================
# Track user behavior and revenue
# Get from: https://analytics.google.com or Firebase Console

# GA4 Measurement ID (starts with G-)
VITE_GA4_MEASUREMENT_ID=

# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false

# ================================
# GOOGLE PLAY BILLING NOTES
# ================================
# Google Play Billing is configured in Google Play Console, not here.
#
# Product IDs must match exactly what's configured in Play Console:
# - premium_pack (non-consumable)
# - coins_100 (consumable)
# - coins_500 (consumable)
# - coins_1200 (consumable)
#
# See GOOGLE_PLAY_SETUP.md for detailed instructions.

# ================================
# DEVELOPMENT NOTES
# ================================
# - Use the test AdMob IDs above during development
# - Replace with your actual IDs before publishing
# - Never commit your .env file to git (it's in .gitignore)
# - For production, set these in your build environment
