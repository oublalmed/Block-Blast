# ================================
# BLOCK BLAST - ANDROID MONETIZATION
# ================================
#
# This app is Google Play only:
# - Payments use Google Play Billing (no external keys).
# - Ads use Google AdMob.
#
# Product IDs are defined in: src/config/monetization.ts
# (premium_pack, coins_100, coins_500, coins_1200)
#
# Configure AdMob app/ad unit IDs in native config.
# Example (replace with your real IDs):
# ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
